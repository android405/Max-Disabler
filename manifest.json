{
    "manifest_version": 3,
    "name": "Max-Disabler",
    "version": "0.2",
    "icons": {
        "32": "assets/icon32.png",
        "64": "assets/icon64.png",
        "128": "assets/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.max.ru/*",
                "*://web.max.ru/*"
            ],
            "js": [
                "main.js"
            ]
        }
    ],
    "action": {
        "default_icon": {
            "32": "assets/icon32.png",
            "64": "assets/icon64.png",
            "128": "assets/icon128.png"
        },
        "default_title": "Max-Disabler",
        "default_popup": "popup/index.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/icon32.png"
            ],
            "matches": [
                "*://*.max.ru/*"
            ]
        }
    ]
}